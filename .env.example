# DevOpsHub Environment Configuration
# Database Connection Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devopshub
DB_USER=root
DB_PASSWORD=root
DB_POOL_SIZE=10

# Application Settings
APP_NAME=DevOpsHub
APP_ENV=development
APP_LOG_LEVEL=INFO

# Execution Engine Configuration
EXECUTION_MAX_CONCURRENT_PIPELINES=4
EXECUTION_DEFAULT_TIMEOUT_SECONDS=300
EXECUTION_WORKSPACE_DIR=./workspaces
