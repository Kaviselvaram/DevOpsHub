# DevOpsHub Environment Configuration

# Database Connection Settings (MySQL Primary)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devopshub
DB_USER=root
DB_PASSWORD=root
DB_POOL_SIZE=10

# Persistent Fallback Storage (Embedded H2 Disk-Backed)
# When MySQL is unavailable, DevOpsHub stores durable data at this path.
DATABASE_STORAGE_PATH=./data/devopshub
# Set to true ONLY for ephemeral automated test environments where durability across restarts is unwanted.
H2_IN_MEMORY_ONLY=false

# Application Settings
APP_NAME=DevOpsHub
APP_ENV=development
APP_LOG_LEVEL=INFO

# Webhook Authentication & Security (HMAC-SHA256 & Replay Protection)
WEBHOOK_PORT=8080
# Primary secret key for verifying X-Hub-Signature-256 HMAC-SHA256 signatures.
# Insecure default tokens have been removed. Webhooks will fail closed (503/401) if not set.
WEBHOOK_SECRET_KEY=change-me-to-a-cryptographically-secure-random-secret
# Secondary secret key used during key rotation periods (optional)
WEBHOOK_ROTATION_SECRET_KEY=

# Execution Engine & Process Isolation Configuration
EXECUTION_MAX_CONCURRENT_PIPELINES=4
EXECUTION_DEFAULT_TIMEOUT_SECONDS=300
EXECUTION_WORKSPACE_DIR=./workspaces
# Security Isolation Policies (SEC-01):
# Set to true to permit trusted local repositories to execute on the host desktop (environment sanitized).
ALLOW_HOST_EXECUTION_FOR_TRUSTED=true
# Set to false to fail-closed on untrusted/external repositories when no container engine sandbox is available.
ALLOW_REMOTE_REPOS_AS_TRUSTED=false
